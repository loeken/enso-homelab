        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "pluginVersion": "11.4.0",
      "title": "Source inventory — what each source collects",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-main" },
          "rawSql": "SELECT\n    source,\n    'spot'   AS table,\n    domain,\n    countDistinct(base, quote) AS pairs,\n    count()                    AS rows,\n    formatDateTime(max(measured_at), '%Y-%m-%d %H:%i:%S') AS latest,\n    toUInt8(1) AS price,\n    toUInt8(0) AS open_high_low,\n    toUInt8(0) AS volume,\n    any(base)  AS base_currency,\n    arrayStringConcat(arraySort(groupUniqArray(quote)), ', ') AS sample_quotes\nFROM machine.events_spot\nGROUP BY source, domain\nUNION ALL\nSELECT\n    source,\n    'ohlcv'  AS table,\n    domain,\n    countDistinct(symbol, quote) AS pairs,\n    count()                      AS rows,\n    formatDateTime(max(measured_at), '%Y-%m-%d %H:%i:%S') AS latest,\n    toUInt8(1) AS price,\n    toUInt8(countIf(open != 0 OR high != 0 OR low != 0) > 0) AS open_high_low,\n    toUInt8(countIf(volume != 0) > 0) AS volume,\n    any(symbol) AS base_currency,\n    arrayStringConcat(arraySort(groupUniqArray(concat(symbol,'/', quote))), ', ') AS sample_quotes\nFROM machine.events_ohlcv\nGROUP BY source, domain\nORDER BY source",
          "format": "table",
          "refId": "A"
        }
      ]
    }
