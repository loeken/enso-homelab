          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT\n    $__timeInterval(measured_at) AS time,\n    argMin(open,  measured_at)   AS open,\n    max(high)                    AS high,\n    min(low)                     AS low,\n    argMax(price, measured_at)   AS close,\n    sum(volume)                  AS volume\nFROM machine.events_ohlcv\nWHERE $__timeFilter(measured_at)\n  AND symbol IN ($symbol)\nGROUP BY time\nORDER BY time",
