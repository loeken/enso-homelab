        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-main" },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT\n  $__timeInterval(measured_at) AS time,\n  pipeline AS series,\n  max(lag_seconds) AS lag_s\nFROM machine.metrics_pipeline_lag\nWHERE $__timeFilter(measured_at)\nGROUP BY time, series\nORDER BY time",
