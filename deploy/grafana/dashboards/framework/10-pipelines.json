      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-main" },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT\n  pipeline,\n  stage_index,\n  processor,\n  max(lag_messages) AS lag_messages,\n  round(max(lag_seconds), 3) AS lag_s,\n  max(measured_at) AS last_measured\nFROM machine.metrics_pipeline_lag\nWHERE measured_at >= now() - INTERVAL 5 MINUTE\nGROUP BY pipeline, stage_index, processor\nORDER BY pipeline, stage_index",
          "refId": "A"
        }
      ],
      "title": "Pipeline \u00d7 Stage Matrix",
      "type": "table"
    },
