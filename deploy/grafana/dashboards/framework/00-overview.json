          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT\n  $__timeInterval(measured_at) AS time,\n  family,\n  count() AS events\nFROM (\n  SELECT measured_at, 'spot' AS family\n  FROM machine.events_spot\n  WHERE $__timeFilter(measured_at)\n  UNION ALL\n  SELECT measured_at, 'ohlcv' AS family\n  FROM machine.events_ohlcv\n  WHERE $__timeFilter(measured_at)\n)\nGROUP BY time, family\nORDER BY time",
