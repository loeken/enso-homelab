              { "id": "unit", "value": "s" },
              { "id": "displayName", "value": "cursor_age" },
              { "id": "custom.width", "value": 110 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "cadence_s" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "displayName", "value": "cadence" },
              { "id": "custom.width", "value": 90 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "last_fetch" },
