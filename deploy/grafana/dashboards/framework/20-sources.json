              { "id": "custom.width", "value": 90 }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "displayName": "quarantined_at", "desc": true }]
      },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-main" },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT\n  formatDateTime(quarantined_at, '%Y-%m-%d %H:%i:%S') AS quarantined_at,\n  component AS source,\n  layer,\n  reason,\n  error_message,\n  status,\n  retry_count\nFROM machine.quarantine\nWHERE component IN (${source:singlequote})\nORDER BY quarantined_at DESC\nLIMIT 100",
          "refId": "A"
        }
      ],
      "title": "Quarantine Error Detail — $source",
      "type": "table"
    },
    {
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-main" },
      "description": "Total events ingested per source within the selected time range, filtered on ingested_at (when the row arrived in ClickHouse) rather than measured_at (the semantic rate date).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 80, "lineWidth": 0 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 26 },
      "id": 7,
      "options": {
        "xField": "source",
        "orientation": "auto",
        "groupWidth": 0.7,
        "barWidth": 0.97,
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-main" },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT\n  source,\n  count() AS events\nFROM (\n  SELECT source FROM machine.events_spot\n  WHERE ingested_at >= toDateTime($__from/1000)\n    AND ingested_at <= toDateTime($__to/1000)\n    AND source IN (${source:singlequote})\n  UNION ALL\n  SELECT source FROM machine.events_ohlcv\n  WHERE ingested_at >= toDateTime($__from/1000)\n    AND ingested_at <= toDateTime($__to/1000)\n    AND source IN (${source:singlequote})\n)\nGROUP BY source\nORDER BY events DESC",
          "refId": "A"
        }
      ],
      "title": "Events per Source — $source",
      "type": "barchart"
    }
