      "title": "Exchange Rate over Time",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-main" },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT\n    $__timeInterval(measured_at) AS time,\n    concat(source, '  ', base, '/', quote) AS series,\n    avg(rate) AS rate\nFROM machine.events_spot\nWHERE $__timeFilter(measured_at)\n  AND source IN ($source)\n  AND base   IN ($base)\n  AND quote  IN ($quote)\nGROUP BY time, series\nORDER BY time",
          "refId": "A"
        }
      ]
