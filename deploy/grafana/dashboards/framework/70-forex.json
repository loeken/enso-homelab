      "pluginVersion": "11.4.0",
      "title": "Latest Rates",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-main" },
          "editorType": "sql",
          "format": 0,
          "rawSql": "SELECT\n    source,\n    base,\n    quote,\n    argMax(rate, measured_at)                                  AS rate,\n    formatDateTime(max(measured_at), '%Y-%m-%d %H:%i:%S UTC') AS last_seen\nFROM machine.events_spot\nWHERE source IN ($source)\n  AND base   IN ($base)\n  AND quote  IN ($quote)\nGROUP BY source, base, quote\nORDER BY source, base, quote",
          "refId": "A"
        }
