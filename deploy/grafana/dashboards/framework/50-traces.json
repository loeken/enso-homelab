{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Distributed trace search and service map powered by Tempo",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "templating": {
    "list": [
      {
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "name": "service",
        "label": "Pipeline Stage",
        "datasource": { "type": "tempo", "uid": "tempo" },
        "definition": "label_values(resource.service.name)",
        "query": "label_values(resource.service.name)",
        "options": [],
        "current": {},
        "refresh": 1,
        "sort": 1,
        "type": "query"
      },
      {
        "hide": 0,
        "name": "span_name",
        "label": "Span Name",
        "query": ".*",
        "current": { "text": ".*", "value": ".*" },
        "options": [],
        "type": "textbox"
      },
      {
        "hide": 0,
        "name": "min_duration",
        "label": "Min Duration",
        "type": "custom",
        "query": "Any : 0ms, > 10ms : 10ms, > 50ms : 50ms, > 100ms : 100ms, > 200ms : 200ms, > 500ms : 500ms",
        "options": [
          { "selected": true,  "text": "Any",    "value": "0ms"   },
          { "selected": false, "text": "> 10ms",  "value": "10ms"  },
          { "selected": false, "text": "> 50ms",  "value": "50ms"  },
          { "selected": false, "text": "> 100ms", "value": "100ms" },
          { "selected": false, "text": "> 200ms", "value": "200ms" },
          { "selected": false, "text": "> 500ms", "value": "500ms" }
        ],
        "current": { "selected": true, "text": "Any", "value": "0ms" },
        "multi": false,
        "includeAll": false,
        "refresh": 0,
        "sort": 0
      }
    ]
  },
  "panels": [
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "description": "Each row is a root trace from the selected service. Collectors emit source.publish spans; processors emit processor.message spans as independent root traces linked back to their upstream stage. Click a Trace ID to follow the full chain.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "duration" },
            "properties": [
              { "id": "unit", "value": "ms" },
              { "id": "decimals", "value": 2 }
            ]
          }
        ]
      },
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "footer": {
          "enablePagination": true,
          "countRows": false,
          "reducer": ["sum"],
          "show": false
        }
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"${service}\" && name=~\"${span_name}\" && duration > ${min_duration}}",
          "limit": 100,
          "refId": "A"
        }
      ],
      "title": "Traces from: ${service}",
      "type": "table"
    }
  ],
  "schemaVersion": 40,
  "tags": ["framework"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Framework: Traces",
  "uid": "fw-traces",
  "version": 2
}
