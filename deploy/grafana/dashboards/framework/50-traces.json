  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "Root traces with linked spans. Collectors emit source.publish spans; processors emit processor.message spans as independent root traces linked back to upstream stages. Click Trace ID to view the full linked chain.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "footer": {
          "countRows": false,
          "enablePagination": true,
          "reducer": [
            "sum"
          ],
          "show": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "limit": 100,
          "query": "{ (name=\"source.publish\" || name=\"processor.message\") && resource.service.name =~ \"${service}\" && duration > ${min_duration} }",
          "queryType": "traceql",
          "refId": "A"
        }
      ],
      "title": "Root Spans (Collectors & Processors): ${service}",
      "type": "table"
    }
  ],
  "preload": false,
