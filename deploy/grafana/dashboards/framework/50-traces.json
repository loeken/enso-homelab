      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {},
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{resource.service.name=~\"${service}\" && name=~\"${span_name}\"}",
          "limit": 50,
          "refId": "A"
        }
      ],
      "title": "Traces from: ${service}",
      "type": "table"
    }
  ],
