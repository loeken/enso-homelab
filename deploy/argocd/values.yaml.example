domain: loeken.xyz
clusterIssuer: letsencrypt-prod
clusterName: enso-homelab
githubUser: loeken
githubRepo: enso-homelab
globalReplicaCount: 1

# app specific
authelia:
  enabled: false
  filesystem:
    enabled: true
  ingress:
    enabled: true
  smtp:
    enabled: false
    host: mail.example.com
    port: 587
    sender: authelia@example.com
    username: authelia@example.com
  storageClassName: rook-ceph-block
  size: 100Mi
certmanager:
  enabled: false
externaldns:
  enabled: false
homeassistant:
  enabled: false
  ingress:
    enabled: false
  storageClass: local-path
  useAuthelia: false
jellyfin:
  enabled: true
  cache:
    enabled: true
    size: 10Gi
    storageClass: local-path
  config:
    enabled: true
    size: 1Gi
    storageClass: local-path
  ingress:
    enabled: true
  useAuthelia: false
jellyseerr:
  enabled: false
  ingress:
    cloudflaretunnel:
      enabled: true
    nginx:
      enabled: false
  config:
    size: 1Gi
    storageClass: rook-ceph-block
  useAuthelia: false
k10:
  enabled: false
  storageClassName: rook-ceph-block
  sidecar:
    enabled: false
nextcloud:
  size: 10Gi
  storageClass: rook-ceph-block
  data:
    accessMode: ReadWriteOnce
    size: 10Gi
    storageClass: rook-ceph-block
  enabled: false
  ingress:
    enabled: true
  securityContext:
    runAsNonRoot: false
    runAsUser: 1000
    runAsGroup: 1000
  smtp:
    domain: example.com
    host: mail.example.com
    port: 587
    sender: nextcloud@example.com
    username: nextcloud@example.com
  storageClass: rook-ceph-block
  useAuthelia: false
nginxingress:
  enabled: false
nzbget:
  enabled: false
  ingress:
    enabled: false
  config:
    size: 1Gi
    storageClass: rook-ceph-block
  downloads:
    size: 100Gi
    storageClass: local-path
  useAuthelia: false
observability:
  enabled: false
  grafana:
    storageClassName: rook-ceph-block
    size: 10Gi
  prometheus:
    storageClassName: rook-ceph-block
    size: 10Gi
  alertmanager:
    storageClassName: rook-ceph-block
    size: 2Gi
  loki:
    storageClassName: rook-ceph-block
    size: 10Gi
  useAuthelia: false
prowlarr:
  enabled: false
  ingress:
    enabled: true
  config:
    size: 1Gi
    storageClass: rook-ceph-block
  useAuthelia: false
radarr:
  enabled: false
  ingress:
    enabled: true
  config:
    size: 1Gi
    storageClass: rook-ceph-block
  useAuthelia: false
rookceph:
  enabled: false
  monitoring: false
rookcephcluster:
  enabled: false
  monitoring: true
  createPrometheusRules: false
sharedmedia:
  enabled: false
  size: 100Gi
  storageClass: rook-ceph-block
vaultwarden:
  enabled: false
  useAuthelia: false
  ingress:
    enabled: true
  storageClassName: rook-ceph-block
  size: 1Gi
  pg:
    storageClassName: rook-ceph-block
    size: 1Gi
whoami:
  enabled: false
uptimekuma:
  enabled: true
  storageClassName: rook-ceph-block
  size: 5Gi