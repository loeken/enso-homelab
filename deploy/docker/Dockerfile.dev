FROM golang:1.24-alpine@sha256:ef18ee7117463ac1055f5a370ed18b8750f01589f13ea0b48642f5792b234044

# Set working directory
WORKDIR /home/devcontainer

# Install required packages
RUN apk add --no-cache \
    bash \
    sudo \
    curl \
    git \
    openssh \
    py3-pip \
    python3 \
    ansible \
    jq \
    make \
    docker-cli \
    coreutils \
    tzdata \
    libc6-compat \
    less \
    vim \
    zsh \
    nodejs \
    npm \
    nano \
    gcc \
    linux-headers \
    python3-dev \
    musl-dev \
    py3-passlib

# Install passlib via pip to support Ansible's password hashing
RUN pip3 install --break-system-packages passlib

# Install k3sup
RUN cd /tmp && curl -sLS https://get.k3sup.dev | sh

# Install act
RUN curl -s https://raw.githubusercontent.com/nektos/act/master/install.sh | sudo bash

# Set up zsh as default shell
RUN sed -i 's#/bin/sh#/bin/zsh#g' /etc/passwd

# Install Renovate globally via npm
RUN npm install -g renovate

# Create a virtualenv for OpenStack CLI
RUN python3 -m venv /venv

# Install OpenStack CLI into venv
RUN . /venv/bin/activate && \
    pip install --upgrade pip && \
    pip install openstackclient

# Optional SSH folder
RUN mkdir -p /root/.ssh

# Set environment
ENV HOME="/root"
ENV GOPATH="$HOME/go"
ENV PATH="$GOPATH/bin:/venv/bin:$PATH"
ENV EDITOR=nano

# Install Terraform manually from HashiCorp
RUN git clone https://github.com/tfutils/tfenv.git ~/.tfenv \
 && ln -s ~/.tfenv/bin/* /usr/local/bin \
 && tfenv install

# Oh My Zsh + Powerlevel10k + plugins
RUN sh -c "$(curl -fsSL https://raw.github.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" && \
    git clone --depth=1 https://github.com/romkatv/powerlevel10k.git ~/.oh-my-zsh/custom/themes/powerlevel10k && \
    git clone https://github.com/zsh-users/zsh-autosuggestions ~/.oh-my-zsh/custom/plugins/zsh-autosuggestions && \
    git clone https://github.com/zsh-users/zsh-syntax-highlighting ~/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting

# Copy ZSH config
COPY deploy/docker/.zshrc /root/.zshrc

# Default command
CMD ["tail", "-f", "/dev/null"]
