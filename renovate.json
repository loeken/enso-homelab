{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "pinDigests": true,
  "enabledManagers": [
    "custom.regex",
    "terraform-version",
    "docker-compose",
    "dockerfile",
    "github-actions",
    "argocd"
  ],
  "argocd": {
    "fileMatch": [
      "deploy/argocd/templates/authelia.yaml",
      "deploy/argocd/templates/certmanager.yaml",
      "deploy/argocd/templates/cluster-issuer.yaml",
      "deploy/argocd/templates/externaldns.yaml",
      "deploy/argocd/templates/homeassistant.yaml",
      "deploy/argocd/templates/import-sealed-secrets.yaml",
      "deploy/argocd/templates/jellyfin.yaml",
      "deploy/argocd/templates/jellyseerr.yaml",
      "deploy/argocd/templates/k10.yaml",
      "deploy/argocd/templates/nextcloud.yaml",
      "deploy/argocd/templates/nzbget.yaml",
      "deploy/argocd/templates/nginxingress.yaml",
      "deploy/argocd/templates/radarr.yaml",
      "deploy/argocd/templates/sonarr.yaml",
      "deploy/argocd/templates/observability_grafana.yaml",
      "deploy/argocd/templates/observability_kube-prometheus-stack-crds.yaml",
      "deploy/argocd/templates/observability_kube-prometheus-stack.yaml",
      "deploy/argocd/templates/observability_loki.yaml",
      "deploy/argocd/templates/observability_promtail.yaml",
      "deploy/argocd/templates/observability_robusta.yaml",
      "deploy/argocd/templates/prowlarr.yaml",
      "deploy/argocd/templates/rook-ceph-cluster.yaml",
      "deploy/argocd/templates/rook-ceph-snapshotter.yaml",
      "deploy/argocd/templates/rook-ceph.yaml",
      "deploy/argocd/templates/sealedsecrets.yaml",
      "deploy/argocd/templates/sharedmedia.yaml",
      "deploy/argocd/templates/uptime-kuma.yaml",
      "deploy/argocd/templates/vaultwarden.yaml",
      "deploy/argocd/templates/whoami.yaml",
      "deploy/argocd/templates/qdrant.yaml",
      "deploy/argocd/templates/postgresql.yaml",
      "deploy/argocd/templates/open-webui.yaml",
      "deploy/argocd/templates/litellm.yaml"
    ]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["major", "minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchManagers": ["terraform-version"],
      "pinDigests": false
    },
    {
      "matchPackageNames": ["k3s-docker"],
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "allowedVersions": "^1.32.0 <1.33.0",
      "versioning": "docker"
    },
    {
      "matchPackageNames": ["k3s-github"],
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["github-releases"],
      "extractVersion": "^v(?<version>\\d+\\.\\d+\\.\\d+)\\+k3s\\d+$",
      "allowedVersions": "^1.32.0 <1.33.0",
      "versioning": "loose"
    },
    {
      "matchPackageNames": ["vaultwarden"],
      "matchManagers": ["argocd"],
      "versioning": "loose"
    }
  ],
  "customManagers": [
    
    {
      "customType": "regex",
      "fileMatch": ["^deploy/terraform/k3s/variables.tf$"],
      "matchStrings": [
        "default\\s*=\\s*\"(?<currentValue>v\\d+\\.\\d+\\.\\d+\\+k3s\\d+)\""
      ],
      "depNameTemplate": "k3s-github",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "k3s-io/k3s",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "fileMatch": [".github/workflows/k3s-integration-test.yml"],
      "matchStrings": [
        "--image\\s+rancher/k3s:(?<currentValue>v\\d+\\.\\d+\\.\\d+-k3s\\d+)"
      ],
      "depNameTemplate": "k3s-docker",
      "datasourceTemplate": "docker",
      "packageNameTemplate": "rancher/k3s",
      "versioningTemplate": "docker"
    }
  ]
}
