{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "pinDigests": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchManagers": ["terraform-version"],
      "pinDigests": false
    }
  ],
  "regexManagers": [
    {
      "fileMatch": ["^deploy/terraform/k3s/variables.tf$"],
      "matchStrings": [
        "default\\s*=\\s*\"(?<currentValue>v\\d+\\.\\d+\\.\\d+\\+k3s\\d+)\""
      ],
      "depNameTemplate": "k3s",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "k3s-io/k3s",
      "versioningTemplate": "loose"
    }
  ],
  "enabledManagers": [
    "regex",
    "terraform-version",
    "docker-compose",
    "dockerfile",
    "github-actions"
  ]
}
