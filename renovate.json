{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "pinDigests": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchManagers": ["terraform-version"],
      "pinDigests": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^.*\\.tf$"],
      "matchStrings": [
        "default\\s*=\\s*\"(?<currentValue>v\\d+\\.\\d+\\.\\d+\\+k3s\\d+)\""
      ],
      "depNameTemplate": "k3s",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "k3s-io/k3s",
      "versioning": "k3s-version"
    }
  ],
  "regexManagers": [
    {
      "versioning": "k3s-version",
      "versioningTemplate": {
        "type": "regex",
        "regex": "v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)"
      }
    }
  ],
  "enabledManagers": [
    "terraform-version",
    "docker-compose",
    "dockerfile",
    "github-actions"
  ]
}
