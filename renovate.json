{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "pinDigests": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchManagers": ["terraform-version"],
      "pinDigests": false
    },
    {
      "matchPackageNames": ["k3s-docker"],
      "allowedVersions": "^v\\d+\\.\\d+\\.\\d+-k3s\\d+$",
      "matchCurrentValue": "^v\\d+\\.\\d+\\.\\d+-k3s\\d+$"
    },
    {
      "matchPackageNames": ["k3s-docker"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchPackageNames": ["k3s-github"],
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["github-releases"],
      "extractVersion": "^v\\d+\\.\\d+\\.\\d+\\+k3s\\d+$",
      "versioning": "loose"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^deploy/terraform/k3s/variables.tf$"],
      "matchStrings": [
        "default\\s*=\\s*\"(?<currentValue>v\\d+\\.\\d+\\.\\d+\\+k3s\\d+)\""
      ],
      "depNameTemplate": "k3s-github",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "k3s-io/k3s",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "fileMatch": [".github/workflows/k3s-integration-test.yml"],
      "matchStrings": [
        "--image\\s+rancher/k3s:(?<currentValue>v\\d+\\.\\d+\\.\\d+(?:-[a-z0-9.]+)*-k3s\\d+(?:-[a-z0-9]+)*)"
      ],
      "depNameTemplate": "k3s-docker",
      "datasourceTemplate": "docker",
      "packageNameTemplate": "rancher/k3s",
      "versioningTemplate": "loose"
    }
  ],
  "enabledManagers": [
    "custom.regex",
    "terraform-version",
    "docker-compose",
    "dockerfile",
    "github-actions"
  ]
}
