name: K3s Integration Test

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read

jobs:
  test-k3s:
    runs-on: ubuntu-latest
    environment: test
    if: github.repository == 'loeken/enso-homelab'
    steps:
      - name: Checkout code
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4

      - name: Set up Docker
        uses: docker/setup-buildx-action@b5ca514318bd6ebac0fb2aedd5d36ec1b5c232a2 # v3

      - name: Install k3d
        run: |
          curl -s https://raw.githubusercontent.com/k3d-io/k3d/main/install.sh | bash

      - name: Create k3d cluster (pinned K3s version, no Traefik)
        run: |
          k3d cluster create ensotest \
            --image rancher/k3s:v1.35.0-k3s1 \
            --k3s-arg "--disable=traefik@server:0" \
            --wait
          kubectl get nodes

      - name: Install Helm
        uses: azure/setup-helm@b9e51907a09c216f16ebe8536097933489208112 # v4
        with:
          version: v3.13.3

      - name: Add ArgoCD Helm repo
        run: |
          helm repo add argo https://argoproj.github.io/argo-helm
          helm repo update

      - name: Install ArgoCD via Helm (pinned)
        run: |
          helm repo add argo https://argoproj.github.io/argo-helm
          helm repo update
          helm upgrade --install argocd argo/argo-cd \
            --namespace argocd \
            --create-namespace \
            --version 8.0.0 \
            --values .github/test/values-argocd.yaml \
            --set server.insecure=true \
            --timeout 5m

      - name: Wait for ArgoCD to be ready
        run: |
          # Wait for deployments to become ready
          echo "Waiting for ArgoCD deployments to be ready..."
          
          # List of ArgoCD components to check
          COMPONENTS=("argocd-server" "argocd-repo-server" "argocd-application-controller")
          
          # Increase timeout to 180s
          for component in "${COMPONENTS[@]}"; do
            echo "Waiting for $component to be available..."

            if kubectl get deployment -n argocd "$component" >/dev/null 2>&1; then
              kubectl wait --for=condition=available --timeout=180s -n argocd deployment/$component || {
                echo "⚠️ Timed out waiting for deployment $component. Checking status..."
                kubectl get pods -n argocd -l "app.kubernetes.io/name=$component"
                kubectl describe deployment -n argocd $component
                kubectl get events -n argocd --sort-by='.lastTimestamp' | grep $component
              }
            elif kubectl get statefulset -n argocd "$component" >/dev/null 2>&1; then
              kubectl rollout status statefulset/$component -n argocd --timeout=180s || {
                echo "⚠️ Timed out waiting for statefulset $component. Checking status..."
                kubectl get pods -n argocd -l "app.kubernetes.io/name=$component"
                kubectl describe statefulset -n argocd $component
                kubectl get events -n argocd --sort-by='.lastTimestamp' | grep $component
              }
            else
              echo "❌ Component $component not found as a Deployment or StatefulSet"
            fi
          done
          
          # Check all pods in argocd namespace
          echo "Current status of ArgoCD pods:"
          kubectl get pods -n argocd
          
          # Check if all pods are running or completed
          NOT_READY=$(kubectl get pods -n argocd -o json | jq -r '.items[] | select(.status.phase != "Running" and .status.phase != "Succeeded") | .metadata.name')
          if [ -n "$NOT_READY" ]; then
            echo "⚠️ Some ArgoCD pods are not ready: $NOT_READY"
            for pod in $NOT_READY; do
              echo "=== Details for $pod ==="
              kubectl describe pod -n argocd $pod
              kubectl logs -n argocd $pod --tail=50
            done
            echo "⚠️ Proceeding anyway, but ArgoCD might not be fully operational."
          else
            echo "✅ ArgoCD is ready!"
          fi

      - name: Apply Sealed Secrets key and External DNS secret
        run: |
          # Create kube-system namespace if it doesn't exist
          kubectl create namespace kube-system --dry-run=client -o yaml | kubectl apply -f -
          
          # Apply the sealed-secrets-key from GitHub secret
          echo "${{ secrets.TEST_SEALED_SECRETS_KEY }}" > sealed-secrets-key.yaml
          kubectl apply -f sealed-secrets-key.yaml
          
          # Create external-dns namespace if it doesn't exist
          kubectl create namespace external-dns --dry-run=client -o yaml | kubectl apply -f -
          
          # Apply the external-dns secret from GitHub secret
          echo "${{ secrets.TEST_EXTERNAL_DNS }}" > external-dns-secret.yaml
          kubectl apply -f external-dns-secret.yaml
          
          echo "✅ Sealed Secrets key and External DNS secret applied successfully"

      - name: Install Sealed Secrets controller
        run: |
          helm repo add sealed-secrets https://bitnami-labs.github.io/sealed-secrets
          helm repo update
          helm install sealed-secrets sealed-secrets/sealed-secrets \
            --namespace kube-system \
            --version 2.17.1
          kubectl wait --for=condition=available --timeout=60s -n kube-system deployment/sealed-secrets


      - name: Configure ArgoCD repository credentials
        run: |
          # Create repository credentials for ArgoCD
          cat <<EOF > repo-secret.yaml
          apiVersion: v1
          kind: Secret
          metadata:
            name: repo-argocd
            namespace: argocd
            labels:
              argocd.argoproj.io/secret-type: repository
          stringData:
            type: git
            url: https://github.com/loeken/enso-homelab.git
          EOF
          kubectl apply -f repo-secret.yaml

      - name: Deploy app-of-apps Application
        run: |
          cat <<EOF > app-of-apps.yaml
          apiVersion: argoproj.io/v1alpha1
          kind: Application
          metadata:
            name: app-of-apps
            namespace: argocd
            finalizers:
              - resources-finalizer.argocd.argoproj.io
          spec:
            project: default
            source:
              path: deploy/argocd
              repoURL: https://github.com/loeken/enso-homelab.git
              targetRevision: ${{ github.head_ref || github.ref_name }}
              helm:
                valueFiles:
                - values-test.yaml
            destination:
              namespace: argocd
              server: https://kubernetes.default.svc
            syncPolicy:
              automated:
                prune: true
                selfHeal: true
              syncOptions:
                - CreateNamespace=true
          EOF
          
          kubectl apply -f app-of-apps.yaml

      - name: Monitor ArgoCD Application Status
        run: |
          # Wait for the app-of-apps to be created and synced
          echo "Waiting for app-of-apps to sync..."
          APP_OF_APPS_MAX_ATTEMPTS=15
          for i in $(seq 1 $APP_OF_APPS_MAX_ATTEMPTS); do
            APP_STATUS=$(kubectl get application app-of-apps -n argocd -o jsonpath='{.status.sync.status}' 2>/dev/null || echo "NotFound")
            HEALTH_STATUS=$(kubectl get application app-of-apps -n argocd -o jsonpath='{.status.health.status}' 2>/dev/null || echo "NotFound")
            
            echo "Attempt $i/$APP_OF_APPS_MAX_ATTEMPTS: Sync Status: $APP_STATUS, Health: $HEALTH_STATUS"
            
            if [ "$APP_STATUS" = "Synced" ] && [ "$HEALTH_STATUS" = "Healthy" ]; then
              echo "✅ app-of-apps is successfully synced and healthy!"
              break
            fi
            
            if [ $i -eq $APP_OF_APPS_MAX_ATTEMPTS ]; then
              echo "❌ Timeout waiting for app-of-apps to sync."
              kubectl get all -A
              kubectl get application -A -o yaml
              exit 1
            fi
            
            sleep 10
          done
          
          # List all applications
          echo "ArgoCD Applications:"
          kubectl get applications -n argocd
          
          # Now wait for all child applications to be synced and healthy
          echo "Waiting for all child applications to sync..."
          MAX_ATTEMPTS=10
          for i in $(seq 1 $MAX_ATTEMPTS); do
            echo "Checking application status (attempt $i/$MAX_ATTEMPTS):"
            
            # Show detailed application status in a table format
            kubectl get applications -n argocd -o custom-columns="NAME:.metadata.name,SYNC:.status.sync.status,HEALTH:.status.health.status"
            
            # Check if any application is not synced or not healthy
            NOT_SYNCED=$(kubectl get applications -n argocd -o jsonpath='{.items[?(@.status.sync.status!="Synced")].metadata.name}')
            NOT_HEALTHY=$(kubectl get applications -n argocd -o jsonpath='{.items[?(@.status.health.status!="Healthy")].metadata.name}')
            
            # If we have apps that aren't synced, show their conditions to understand why
            if [ -n "$NOT_SYNCED" ]; then
              echo "⚠️ Applications not synced yet: $NOT_SYNCED"
              for app in $NOT_SYNCED; do
                echo "===== Details for $app ====="
                kubectl get application $app -n argocd -o jsonpath='{.status.conditions}' | jq -r '.' || echo "Unable to get conditions"
              done
            fi
            
            # If we have apps that aren't healthy, show their conditions
            if [ -n "$NOT_HEALTHY" ]; then
              echo "⚠️ Applications not healthy yet: $NOT_HEALTHY"
              for app in $NOT_HEALTHY; do
                echo "===== Details for $app ====="
                kubectl get application $app -n argocd -o jsonpath='{.status.conditions}' | jq -r '.' || echo "Unable to get conditions"
                # Also check if any pods related to this app are not ready
                namespace=$(kubectl get application $app -n argocd -o jsonpath='{.spec.destination.namespace}' 2>/dev/null)
                if [ -n "$namespace" ]; then
                  echo "Pods in namespace $namespace:"
                  kubectl get pods -n $namespace
                fi
              done
            fi
            
            if [ -z "$NOT_SYNCED" ] && [ -z "$NOT_HEALTHY" ]; then
              echo "✅ All applications are successfully synced and healthy!"
              break
            fi
            
            if [ $i -eq $MAX_ATTEMPTS ]; then
              echo "❌ Timeout waiting for all applications to sync and become healthy."
              echo "Final status of applications:"
              kubectl get applications -n argocd -o wide
              echo "Detailed pod status for problematic namespaces:"
              for app in $NOT_SYNCED $NOT_HEALTHY; do
                namespace=$(kubectl get application $app -n argocd -o jsonpath='{.spec.destination.namespace}' 2>/dev/null)
                if [ -n "$namespace" ]; then
                  echo "==== Pods in namespace $namespace ===="
                  kubectl get pods -n $namespace -o wide
                  echo "==== Events in namespace $namespace ===="
                  kubectl get events -n $namespace --sort-by='.lastTimestamp'
                fi
              done
              exit 1
            fi
            
            echo "Waiting 20 seconds before next check..."
            sleep 20
          done
          
          # Check pod status across all namespaces
          echo "Pod Status:"
          kubectl get pods -A
