name: Release Build and Deploy

on:
  push:
    branches:
      - main
      - staging

permissions:
  contents: write
  packages: write  # Needed for pushing Docker images

jobs:
  versioning:
    if: github.ref == 'refs/heads/main'
    runs-on: self-hosted
    outputs:
      new_version: ${{ steps.bump_version.outputs.NEW_VERSION }}
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Fetch Tags
        run: git fetch --tags

      - name: Get Latest Tag
        id: get_latest
        run: |
          LATEST_TAG=$(git tag --sort=-v:refname | head -n 1 || echo "v1.0.0")
          echo "LATEST_TAG=$LATEST_TAG" >> $GITHUB_ENV

      - name: Bump Version
        id: bump_version
        run: |
          LATEST_VERSION="${LATEST_TAG#v}"  # Remove 'v' prefix
          IFS='.' read -r MAJOR MINOR PATCH <<< "$LATEST_VERSION"
          PATCH=$((PATCH + 1))  # Increment patch version
          NEW_VERSION="v$MAJOR.$MINOR.$PATCH"
          echo "NEW_VERSION=$NEW_VERSION" >> $GITHUB_ENV
          echo "NEW_VERSION=$NEW_VERSION" >> $GITHUB_OUTPUT

      - name: Create Git Tag (Only If New)
        run: |
          if git rev-parse "$NEW_VERSION" >/dev/null 2>&1; then
            echo "Tag $NEW_VERSION already exists, skipping tag creation."
          else
            git tag "$NEW_VERSION"
            git push origin "$NEW_VERSION"
          fi

      - name: Create GitHub Release
        uses: actions/create-release@v1
        with:
          tag_name: ${{ env.NEW_VERSION }}
          release_name: Release ${{ env.NEW_VERSION }}
          body: "Automated release for version ${{ env.NEW_VERSION }}"
          draft: false
          prerelease: false
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

  build-and-push-staging:
    name: Build and Push Staging Image
    runs-on: self-hosted
    if: github.ref == 'refs/heads/staging'
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v2

      - name: Set image tag and Dockerfile
        run: |
          echo "IMAGE_TAG=staging" >> $GITHUB_ENV
          echo "DOCKERFILE=deploy/docker/Dockerfile.staging" >> $GITHUB_ENV

      - name: Log in to Harbor registry
        run: echo "${{ secrets.HARBOR_PASSWORD }}" | docker login ${{ secrets.HARBOR_REGISTRY }} -u "${{ secrets.HARBOR_USERNAME }}" --password-stdin

      - name: Build and push staging image
        uses: docker/build-push-action@v4
        with:
          context: ./
          file: ${{ env.DOCKERFILE }}
          push: true
          tags: |
            ${{ secrets.HARBOR_REGISTRY }}/${{ secrets.HARBOR_PROJECT }}/${{ secrets.IMAGE_NAME }}:staging
            ${{ secrets.HARBOR_REGISTRY }}/${{ secrets.HARBOR_PROJECT }}/${{ secrets.IMAGE_NAME }}:${{ github.sha }}

      - name: Log out of Harbor
        run: docker logout ${{ secrets.HARBOR_REGISTRY }}

  build-and-push-prod:
    name: Build and Push Production Image
    runs-on: self-hosted
    needs: [versioning]
    if: github.ref == 'refs/heads/main'
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v2

      - name: Set image tag and Dockerfile
        run: |
          IMAGE_TAG="${{ needs.versioning.outputs.new_version }}"
          echo "IMAGE_TAG=$IMAGE_TAG" >> $GITHUB_ENV
          echo "DOCKERFILE=deploy/docker/Dockerfile.prod" >> $GITHUB_ENV

      - name: Log in to Harbor registry
        run: echo "${{ secrets.HARBOR_PASSWORD }}" | docker login ${{ secrets.HARBOR_REGISTRY }} -u "${{ secrets.HARBOR_USERNAME }}" --password-stdin

      - name: Build and push production image
        uses: docker/build-push-action@v4
        with:
          context: ./
          file: ${{ env.DOCKERFILE }}
          push: true
          tags: |
            ${{ secrets.HARBOR_REGISTRY }}/${{ secrets.HARBOR_PROJECT }}/${{ secrets.IMAGE_NAME }}:${{ env.IMAGE_TAG }}
            ${{ secrets.HARBOR_REGISTRY }}/${{ secrets.HARBOR_PROJECT }}/${{ secrets.IMAGE_NAME }}:${{ github.sha }}

      - name: Log out of Harbor
        run: docker logout ${{ secrets.HARBOR_REGISTRY }}
