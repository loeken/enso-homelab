name: Test

on:
  push:
    branches:
      - '**'

permissions:
  contents: read
  pull-requests: read

jobs:
  test:
    name: Run tests
    runs-on: self-hosted
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Log in to Harbor registry
        run: echo "${{ secrets.HARBOR_PASSWORD }}" | docker login ${{ secrets.HARBOR_REGISTRY }} -u "${{ secrets.HARBOR_USERNAME }}" --password-stdin

      - name: Build and Run Tests in Docker
        run: |
          docker compose --env-file .env.test -f docker-compose-test.yml up --build --abort-on-container-exit
        shell: bash

      - name: Cleanup Test Containers
        run: docker compose --env-file .env.test -f docker-compose-test.yml down
        shell: bash
